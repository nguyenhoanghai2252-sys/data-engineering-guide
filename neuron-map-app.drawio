        <mxCell id="n4" value="Plane equation" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="840" y="520" width="140" height="80" as="geometry"/></mxCell>
        <mxCell id="n5" value="Angle / distance" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1080" y="350" width="140" height="80" as="geometry"/></mxCell>
