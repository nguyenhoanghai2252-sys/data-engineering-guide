<mxfile host="app.diagrams.net">
  <diagram name="1 - Build process" id="proc">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1700" pageHeight="700">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Neuron-map study &amp; notes app: build process" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="30" as="geometry"/></mxCell>

        <mxCell id="s1" value="1. Goals &amp; users&#xa;(who studies? what subjects?)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="s2" value="2. Data model&#xa;Neuron = note/concept&#xa;Synapse = link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="240" y="80" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="s3" value="3. Board UI&#xa;canvas: drag, zoom, link nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="s4" value="4. Note editor&#xa;Markdown + LaTeX, images, tags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="s5" value="5. Storage&#xa;IndexedDB (offline) + JSON export; optional cloud DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="840" y="80" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="s6" value="6. Study features&#xa;search, review mode, spaced repetition, quiz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1040" y="80" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="s7" value="7. Export&#xa;draw.io XML, PNG/PDF, JSON backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1240" y="80" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="s8" value="8. Test &amp; deploy&#xa;user testing, Vercel/GitHub Pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1440" y="80" width="170" height="80" as="geometry"/></mxCell>

        <mxCell id="e1" style="endArrow=classic;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=classic;html=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="a0" value="Architecture" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="a1" value="Frontend&#xa;React + canvas library (React Flow / D3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="a2" value="State layer&#xa;nodes[] + edges[] (graph JSON)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="270" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="a3" value="Local storage&#xa;IndexedDB (Dexie)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="760" y="270" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="a4" value="Cloud sync (optional)&#xa;Supabase / Firebase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1080" y="270" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="a5" value="draw.io exporter&#xa;graph JSON → mxGraph XML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="ae1" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae2" style="endArrow=classic;startArrow=classic;html=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae3" style="endArrow=classic;startArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae4" style="endArrow=classic;html=1;" edge="1" parent="1" source="a2" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2 - Neuron map example" id="map">
