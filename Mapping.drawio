        <mxCell id="lane-nn-app" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;fontSize=14;fontStyle=1;startSize=38;" value="A1. NEURAL NETWORK &amp; PIPELINE EXECUTION LAYER" vertex="1">
          <mxGeometry height="900" width="600" x="830" y="95" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="lane-nn-app" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;" value="&lt;b&gt;E1. Zero-Bloat Tensor DataLoaders&lt;/b&gt;&lt;br&gt;• Custom PyTorch Map-style (__getitem__) &amp;amp; IterableDataset streams&lt;br&gt;• Zero-copy conversion from Python buffers → NumPy ndarray → Torch Tensor&lt;br&gt;• Multi-worker background prefetching bypassing Python GIL bottlenecks" vertex="1">
          <mxGeometry height="155" width="540" x="30" y="55" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="lane-nn-app" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;" value="&lt;b&gt;E2. Dynamic Batching &amp;amp; Time-Series Windows&lt;/b&gt;&lt;br&gt;• Sliding-window aggregations (7-day rolling spend, RL replay buffers)&lt;br&gt;• Bucketed sequence sorting (Timsort) to minimize padding tokens per batch&lt;br&gt;• Binary search (bisect) for leak-free temporal train/val/test cutoffs" vertex="1">
          <mxGeometry height="155" width="540" x="30" y="260" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="lane-nn-app" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;" value="&lt;b&gt;E3. Tokenization, Encoding &amp;amp; Beam Search&lt;/b&gt;&lt;br&gt;• O(1) hash-map categorical feature &amp;amp; vocabulary ID lookups&lt;br&gt;• Trie-accelerated subword tokenization (BPE / WordPiece) for LLMs&lt;br&gt;• Min/Max heap top-K candidate pruning during autoregressive decoding" vertex="1">
          <mxGeometry height="155" width="540" x="30" y="465" as="geometry" />
        </mxCell>
        <mxCell id="e4" parent="lane-nn-app" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;" value="&lt;b&gt;E4. Autograd DAGs, Vector Search &amp;amp; Alignment&lt;/b&gt;&lt;br&gt;• Topological sort powering PyTorch backpropagation &amp;amp; Airflow task DAGs&lt;br&gt;• HNSW proximity graph traversal for fast embedding similarity search&lt;br&gt;• Dynamic programming for CTC speech alignment &amp;amp; edit-distance metrics" vertex="1">
