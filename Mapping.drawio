        <mxCell id="bridge-3" edge="1" parent="1" source="f-linux" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;strokeWidth=2.5;fontColor=#92400e;fontStyle=1;fontSize=11;" target="t-linux" value="Shards &amp; Prefetches I/O">
