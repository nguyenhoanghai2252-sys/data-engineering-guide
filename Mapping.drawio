        <mxCell id="rt-3" edge="1" parent="lane-tensor" source="t-linux" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16a34a;strokeWidth=2;" target="t-git">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bridge-1" edge="1" parent="1" source="f-py" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;strokeWidth=2.5;fontColor=#92400e;fontStyle=1;fontSize=11;" target="t-py" value="Yields Tensor Batches">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bridge-2" edge="1" parent="1" source="f-sql" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d97706;strokeWidth=2.5;fontColor=#92400e;fontStyle=1;fontSize=11;" target="t-sql" value="Extracts Clean Features">
